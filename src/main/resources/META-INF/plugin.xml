<idea-plugin>
    <id>org.sajith.agentcli.plugin</id>
    <name>Agent CLI</name>
    <version>0.2.0</version>
    <vendor>org.sajith</vendor>

    <description><![CDATA[
    Integrates AI Agent CLI sessions directly into your IDE.
    Open multiple Claude Code, Cursor, Gemini, etc. terminal sessions, switch between them, and browse session history.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Agent CLI"
                    anchor="right"
                    secondary="false"
                    factoryClass="org.sajith.agentcli.plugin.toolwindow.AgentCliToolWindowFactory"
                    icon="/icons/agent-cli.svg"/>

        <applicationConfigurable
                id="org.sajith.agentcli.plugin.settings"
                groupId="tools"
                displayName="Agent CLI"
                instance="org.sajith.agentcli.plugin.settings.AgentCliSettingsConfigurable"/>

        <applicationService
                serviceImplementation="org.sajith.agentcli.plugin.settings.AgentCliSettings"/>
    </extensions>
</idea-plugin>
